# ---------------------------------------------------------------- required
# Host group ids that own the GPU device nodes:
#   getent group video render | cut -d: -f1,3
VIDEO_GID=44
RENDER_GID=109

# The resolution your display runs at. Needed to match its refresh rate to the source.
VPROC_OUTPUT_SIZE=3840x2160

# ---------------------------------------------------------------- optional
# Which release of the published image to run (default: the newest).
#VPROC_VERSION=0.2.4

# Where Desktop Video put the capture library on the host (RHEL/Fedora: /lib64/libDeckLinkAPI.so).
#DECKLINK_LIB=/usr/lib/libDeckLinkAPI.so

# Web UI port (the container uses the host's network directly).
#VPROC_PORT=8000

# Port for the Unfolded Circle Remote driver, used only while it's switched on in the UI.
#VPROC_UC_PORT=9095

# Require "Authorization: Bearer <token>" for the API (the web UI asks once).
#VPROC_API_TOKEN=

# Which input to start on, until one is chosen in the web UI (which then wins):
# an index (0), part of the name ("Quad HDMI Recorder (2)"),
# or a persistent id ("id:1234"; see python3 -m vproc.doctor).
#VPROC_DEVICE=0

# Video output. The default drives the display directly through Vulkan.
#VPROC_GPU_API=vulkan
#VPROC_GPU_CONTEXT=displayvk
# Mode when the source doesn't decide one (no signal, or a rate the display lacks), e.g. 3840x2160@60.
# "preferred": VPROC_OUTPUT_SIZE at its highest rate (or, without it, the display's own preferred mode).
#VPROC_DISPLAY_MODE=preferred
# Which display, when the GPU has several connected (mpv's numbering).
#VPROC_VULKAN_DISPLAY=0

# Alternative output: OpenGL over DRM/GBM (VPROC_GPU_API=opengl, VPROC_GPU_CONTEXT=drm).
# On NVIDIA it needs GBM_BACKENDS_PATH on RHEL-family hosts, and mpv 0.42 sends HDR
# metadata the driver rejects on every frame, so prefer the Vulkan default.
#VPROC_DRM_DEVICE=/dev/dri/card1
#VPROC_DRM_CONNECTOR=HDMI-A-1
#VPROC_DRM_FORMAT=xrgb8888

# The display's DDC bus, so a lost HDMI lock (some projectors after switching inputs)
# is noticed and the picture restored. Set by: sudo bash scripts/enable-ddc.sh
#VPROC_DDC_DEVICE=/dev/vproc-ddc

# Switch the display's refresh rate to suit the source, and how to map rates.
#VPROC_MATCH_REFRESH=true
#VPROC_REFRESH_MAP=23.976=23.976,24=24,25=50,29.97=59.94,30=60,50=50,59.94=59.94,60=60

# Dolby Vision via LLDV (player-led) without an HDFury relabelling it as HDR10:
# SDR-flagged BT.2020 input is read as HDR10 at VPROC_LLDV_PEAK nits, which should
# match the target in the Dolby Vision block of your sources' EDID (HDFury EDID 10: ~1390).
#VPROC_LLDV=true
#VPROC_LLDV_PEAK=1000

# The capture card's own EDID tells sources it accepts SDR and HDR10 but not HLG, so
# some send HLG as SDR. vproc adds HLG; false leaves the card's EDID untouched.
#VPROC_EDID_HLG=true

# Lip sync: send vproc's video delay (+ an offset for the display) to your AV processor
# whenever a new signal settles. Comma-separated URLs; {delay_ms} is replaced by the delay.
# AudioControl Hyperion, one URL per input that goes through vproc:
#VPROC_LIPSYNC_URLS=http://hyperion.local:8080/api/atlas/input/1/lipsync/{delay_ms},http://hyperion.local:8080/api/atlas/input/2/lipsync/{delay_ms}
#VPROC_LIPSYNC_OFFSET=0
#VPROC_LIPSYNC_METHOD=POST

# How full-range PC (RGB) sources are treated: full | limited
#VPROC_RGB_RANGE=full

# Frames buffered between capture and mpv. 2 keeps latency low.
#VPROC_QUEUE_DEPTH=2

#VPROC_LOG_LEVEL=info
#VPROC_MPV_LOG_LEVEL=warn
#VPROC_MPV_EXTRA_ARGS=

# ---------------------------------------------------------------- building from source
# Only for `docker compose -f compose.yml -f compose.build.yml up -d --build`.
# Folder holding DeckLinkAPI.h etc. from your Blackmagic DeckLink SDK download.
#DECKLINK_SDK_INCLUDE="/home/you/sdk/Blackmagic DeckLink SDK 16.0/Linux/include"

# Pinned upstream releases (build args).
#FFMPEG_VERSION=9.0.2
#LIBPLACEBO_VERSION=7.387.0
#MPV_VERSION=0.42.0
