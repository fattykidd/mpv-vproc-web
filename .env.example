# ---------------------------------------------------------------- required
# Folder holding DeckLinkAPI.h etc. from the Blackmagic DeckLink SDK download
# ("Blackmagic DeckLink SDK <version>/Linux/include"). Used at build time only.
DECKLINK_SDK_INCLUDE="/home/you/sdk/Blackmagic DeckLink SDK 15.0/Linux/include"

# Host group ids that own the GPU device nodes:
#   getent group video render | cut -d: -f1,3
VIDEO_GID=44
RENDER_GID=109

# The resolution your display runs at. Needed to match its refresh rate to the source.
VPROC_OUTPUT_SIZE=3840x2160

# ---------------------------------------------------------------- optional
# Where Desktop Video put the capture library on the host.
#DECKLINK_LIB=/usr/lib/libDeckLinkAPI.so

# Web UI port on the host.
#HOST_PORT=8000

# Require "Authorization: Bearer <token>" for the API (the web UI asks once).
#VPROC_API_TOKEN=

# Which input: an index (0), part of the name ("Quad HDMI Recorder (2)"),
# or a persistent id ("id:1234"; see python3 -m vproc.doctor).
#VPROC_DEVICE=0

# Video output. The defaults drive the HDMI port directly with OpenGL over KMS.
# If OpenGL/GBM won't come up on NVIDIA, try VPROC_GPU_API=vulkan with VPROC_GPU_CONTEXT=displayvk.
#VPROC_GPU_API=opengl
#VPROC_GPU_CONTEXT=drm
#VPROC_DRM_CONNECTOR=HDMI-A-1
#VPROC_DRM_MODE=preferred
# xrgb2101010 gives a 10-bit output path if the driver supports it.
#VPROC_DRM_FORMAT=xrgb8888

# Switch the display's refresh rate to suit the source, and how to map rates.
#VPROC_MATCH_REFRESH=true
#VPROC_REFRESH_MAP=23.976=23.976,24=24,25=50,29.97=59.94,30=60,50=50,59.94=59.94,60=60

# How full-range PC (RGB) sources are treated: full | limited
#VPROC_RGB_RANGE=full

# Frames buffered between capture and mpv. 2 keeps latency low.
#VPROC_QUEUE_DEPTH=2

#VPROC_LOG_LEVEL=info
#VPROC_MPV_LOG_LEVEL=warn
#VPROC_MPV_EXTRA_ARGS=

# Pinned upstream releases (build args).
#FFMPEG_VERSION=9.0.2
#LIBPLACEBO_VERSION=7.387.0
#MPV_VERSION=0.42.0
